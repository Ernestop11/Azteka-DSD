  cardStylePreset    String?  @default("dark-red")
  imageBg            String?  @default("linear-gradient(180deg, #1e293b 0%, #334155 100%)")
  imageEffect        String?  @default("none")
  // Colors
  primaryColor       String   @default("#10b981") // Emerald for add buttons
  accentColor        String   @default("#3b82f6") // Blue for badges
  // Effects
