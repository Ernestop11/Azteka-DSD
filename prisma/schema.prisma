generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String   @id
  userId    String
  service   String
  key       String
  status    String   @default("disconnected")
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, service])
}

model Badge {
  id          String      @id
  name        String
  description String
  points      Int         @default(0)
  iconUrl     String?
  UserBadge   UserBadge[]
}

model Brand {
  id           String    @id
  name         String
  logoUrl      String?
  description  String?
  isFeatured   Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  slug         String?   @unique
  imageUrl     String?
  Product      Product[]
}

model Category {
  id           String        @id
  name         String
  slug         String        @unique
  description  String?
  imageUrl     String?
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  Product      Product[]
  Subcategory  Subcategory[]
}

model ContractWorker {
  id        String   @id
  userId    String   @unique
  type      String
  active    Boolean  @default(true)
  earnings  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
  Job       Job[]
}

model Customer {
  id           String   @id
  businessName String
  contactName  String
  email        String   @unique
  phone        String
  address      String
  city         String
  state        String
  zipCode      String
  salesRepId   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model Incentive {
  id          String   @id
  title       String
  description String
  threshold   Int
  reward      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
}

model Invoice {
  id          String    @id
  supplier    String
  invoiceDate DateTime?
  fileUrl     String
  status      String    @default("processed")
  total       Decimal   @default(0) @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
}

model Job {
  id             String          @id
  type           String
  title          String
  description    String
  location       String?
  commission     Decimal         @db.Decimal(10, 2)
  status         String          @default("available")
  workerId       String?
  deadline       DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  ContractWorker ContractWorker? @relation(fields: [workerId], references: [id])
}

model LoyaltyAccount {
  id        String   @id
  userId    String   @unique
  points    Int      @default(0)
  tier      String   @default("Bronze")
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

model OAuthConnection {
  id           String    @id
  userId       String
  service      String
  accessToken  String?
  refreshToken String?
  accountName  String?
  connected    Boolean   @default(false)
  lastSync     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  User         User      @relation(fields: [userId], references: [id])

  @@unique([userId, service])
}

model OAuthState {
  id        String   @id
  userId    String
  service   String
  state     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Order {
  id           String      @id
  status       String      @default("pending")
  customerName String
  total        Decimal     @db.Decimal(10, 2)
  userId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  driverId     String?
  notes        String?
  User         User?       @relation(fields: [userId], references: [id])
  OrderItem    OrderItem[]
}

model OrderItem {
  id        String   @id
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  orderId   String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Order     Order    @relation(fields: [orderId], references: [id])
  Product   Product  @relation(fields: [productId], references: [id])
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  sku                String              @unique
  description        String?
  price              Decimal             @db.Decimal(10, 2)
  inStock            Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  minStock           Int                 @default(10)
  stock              Int                 @default(0)
  supplier           String?             @default("Default Supplier")
  cost               Decimal?            @db.Decimal(10, 2)
  imageUrl           String?             @default("")
  margin             Decimal?            @db.Decimal(5, 2)
  backgroundColor    String?             @default("#f3f4f6")
  brandId            String?
  categoryId         String?
  featured           Boolean             @default(false)
  minOrderQty        Int                 @default(1)
  subcategoryId      String?
  unitType           String              @default("case")
  unitsPerCase       Int                 @default(1)
  backgroundRemoved  Boolean             @default(false)
  special            Boolean             @default(false)
  splashImageUrl     String?             @default("")
  gradientPresetId   String?
  glowPresetId       String?
  splashPresetId     String?
  seasonal           Boolean             @default(false)
  trending           Boolean             @default(false)
  backgroundGradient String?
  tier               String?
  priceTierA         Decimal?            @db.Decimal(10, 2)
  priceTierB         Decimal?            @db.Decimal(10, 2)
  priceTierC         Decimal?            @db.Decimal(10, 2)
  points             Int?                @default(0)
  glossLevel         String?             @default("none")
  sparkle            Boolean?            @default(false)
  badge              String?
  theme              String?             @default("default")
  // Weekend Special fields (for grocery-style UI)
  isWeekendSpecial   Boolean             @default(false)
  weekendPrice       Decimal?            @db.Decimal(10, 2)
  weekendStartDate   DateTime?
  weekendEndDate     DateTime?
  displayOrder       Int                 @default(0)
  OrderItem          OrderItem[]
  Brand              Brand?              @relation(fields: [brandId], references: [id])
  Category           Category?           @relation(fields: [categoryId], references: [id])
  Subcategory        Subcategory?        @relation(fields: [subcategoryId], references: [id])
  PurchaseOrderItem  PurchaseOrderItem[]
  ProductBundle      ProductBundle[]     @relation("BundleProducts")
  SpecialOffer       SpecialOffer[]      @relation("OfferProducts")
  Promotion          Promotion[]         @relation("PromotionProducts")
  sectionItems       CatalogSectionItem[]
  blockProducts      CatalogBlockProduct[]

  @@index([isWeekendSpecial])
  @@index([displayOrder])
}

model ProductBundle {
  id              String    @id
  name            String
  slug            String    @unique
  description     String?
  imageUrl        String?
  badgeText       String?
  badgeColor      String?   @default("#10b981")
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  price           Decimal   @db.Decimal(10, 2)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  sku             String?
  stock           Int?      @default(0)
  inStock         Boolean?  @default(true)
  minStock        Int?      @default(5)
  featured        Boolean?  @default(false)
  businessModes   String[]  @default([])
  categoryId      String?
  brandId         String?
  Product         Product[] @relation("BundleProducts")
}

model Promotion {
  id              String    @id
  title           String
  description     String?
  discountPercent Decimal   @db.Decimal(5, 2)
  startDate       DateTime
  endDate         DateTime
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Product         Product[] @relation("PromotionProducts")
}

model PurchaseOrder {
  id                String              @id
  supplier          String
  status            String              @default("pending")
  total             Decimal             @default(0) @db.Decimal(10, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  PurchaseOrderItem PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id
  productId       String
  quantity        Int
  cost            Decimal       @db.Decimal(10, 2)
  purchaseOrderId String
  Product         Product       @relation(fields: [productId], references: [id])
  PurchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model Reward {
  id          String  @id
  title       String
  description String
  cost        Int
  imageUrl    String?
  active      Boolean @default(true)
}

model SalesRep {
  id             String   @id
  name           String
  email          String   @unique
  phone          String?
  territory      String?
  uniqueLinkCode String   @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
}

model SpecialOffer {
  id          String    @id
  title       String
  description String?
  imageUrl    String?
  ctaText     String    @default("Shop Now")
  ctaLink     String?
  validUntil  DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Product     Product[] @relation("OfferProducts")
}

model Subcategory {
  id           String    @id
  name         String
  description  String?
  displayOrder Int       @default(0)
  categoryId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Product      Product[]
  Category     Category  @relation(fields: [categoryId], references: [id])
}

model User {
  id              String            @id
  email           String            @unique
  name            String
  role            String            @default("CUSTOMER")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  password        String            @default("")
  ApiKey          ApiKey[]
  ContractWorker  ContractWorker?
  LoyaltyAccount  LoyaltyAccount?
  OAuthConnection OAuthConnection[]
  Order           Order[]
  Session         Session[]
  UserBadge       UserBadge[]
}

model UserBadge {
  id       String   @id
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  Badge    Badge    @relation(fields: [badgeId], references: [id])
  User     User     @relation(fields: [userId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_REP
  WAREHOUSE
  DRIVER
  CUSTOMER
}

// ============================================
// CATALOG SECTION SYSTEM (Alessa-style layout)
// ============================================

model CatalogSection {
  id          String               @id @default(uuid())
  name        String
  description String?
  type        CatalogSectionType   @default(GROCERY)
  position    Int                  @default(0)
  hero        Boolean              @default(false)
  imageUrl    String?
  badgeText   String?
  badgeColor  String?              @default("#10b981")
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       CatalogSectionItem[]

  @@index([position])
  @@index([active])
}

model CatalogSectionItem {
  id           String         @id @default(uuid())
  sectionId    String
  productId    String
  displayOrder Int            @default(0)
  featured     Boolean        @default(false)
  section      CatalogSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@unique([sectionId, productId])
  @@index([sectionId])
  @@index([displayOrder])
}

enum CatalogSectionType {
  GROCERY
  CHIPS
  CANDY
  BEVERAGES
  SEASONAL
  SPECIAL
  BUNDLES
  FEATURED
  BAKERY
  DAIRY
  OTHER
}

// ============================================
// CATALOG BLOCK BUILDER SYSTEM
// ============================================

model CatalogSettings {
  id                  String   @id @default("default")
  backgroundGradient  String   @default("linear-gradient(180deg, #0f3d0f 0%, #1a4d1a 50%, #0d2e0d 100%)")
  backgroundPattern   String?
  patternOpacity      Float    @default(0.1)
  patternSize         String?  @default("40px 40px")
  headerStyle         String   @default("default")
  primaryColor        String   @default("#d4a853")
  secondaryColor      String   @default("#059669")
  animation           String?  // pulse, shimmer, gradient-shift, aurora
  glowEffect          Boolean  @default(false)
  particleEffect      String?  // confetti, sparkle, etc
  updatedAt           DateTime @updatedAt
}

model CatalogBlock {
  id        String                @id @default(uuid())
  type      CatalogBlockType      @default(PRODUCT_GRID)
  title     String?
  subtitle  String?
  badgeText String?
  ctaText   String?
  ctaLink   String?
  config    Json                  @default("{}")
  position  Int                   @default(0)
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  products  CatalogBlockProduct[]

  @@index([position])
  @@index([active])
}

model CatalogBlockProduct {
  id           String       @id @default(uuid())
  blockId      String
  productId    String
  displayOrder Int          @default(0)
  block        CatalogBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([blockId, productId])
  @@index([blockId])
  @@index([displayOrder])
}

enum CatalogBlockType {
  HERO
  PRODUCT_GRID
  PRODUCT_CARDS
  BANNER
  CATEGORY_ROW
  PROMO_SECTION
  // DSD Wholesale Block Types
  RACK_BUNDLE
  VENDOR_SPOTLIGHT
  CASE_DEAL
  NEW_ARRIVALS
  QUICK_REORDER
  BULK_BUILDER
  SEASONAL_THEME
  BRAND_SHOWCASE
}
