generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String   @id
  userId    String
  service   String
  key       String
  status    String   @default("disconnected")
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, service])
}

model Badge {
  id          String      @id
  name        String
  description String
  points      Int         @default(0)
  iconUrl     String?
  UserBadge   UserBadge[]
}

model Brand {
  id           String       @id
  name         String
  logoUrl      String?
  description  String?
  isFeatured   Boolean      @default(false)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  slug         String?      @unique
  imageUrl     String?
  Product      Product[]
  layout       BrandLayout?
}

model Category {
  id           String          @id
  name         String
  slug         String          @unique
  description  String?
  imageUrl     String?
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime
  Product      Product[]
  Subcategory  Subcategory[]
  layout       CategoryLayout?
}

model ContractWorker {
  id        String   @id
  userId    String   @unique
  type      String
  active    Boolean  @default(true)
  earnings  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
  Job       Job[]
}

model Customer {
  id                 String                  @id
  businessName       String
  contactName        String
  email              String                  @unique
  phone              String
  address            String
  city               String
  state              String
  zipCode            String
  salesRepId         String?
  salesRep           SalesRep?               @relation(fields: [salesRepId], references: [id])
  active             Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime
  // Pricing tier (A=best, B=standard, C=basic)
  priceTier          String                  @default("B")
  // Geolocation for route optimization
  latitude           Float?
  longitude          Float?
  // Visit scheduling
  visitFrequency     String?                 @default("weekly") // 3x_week, 2x_week, weekly, biweekly
  preferredDays      String[]                @default([]) // ["monday", "thursday"]
  lastVisitDate      DateTime?
  nextScheduledVisit DateTime?
  // Customer group for multi-account reporting
  groupId            String?
  group              CustomerGroup?          @relation("CustomerGroupMembers", fields: [groupId], references: [id])
  // Price overrides
  priceOverrides     CustomerPriceOverride[]
  // Orders
  orders             Order[]
}

model Incentive {
  id          String   @id
  title       String
  description String
  threshold   Int
  reward      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
}

model Invoice {
  id          String    @id
  supplier    String
  invoiceDate DateTime?
  fileUrl     String
  status      String    @default("processed")
  total       Decimal   @default(0) @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
}

model Job {
  id             String          @id
  type           String
  title          String
  description    String
  location       String?
  commission     Decimal         @db.Decimal(10, 2)
  status         String          @default("available")
  workerId       String?
  deadline       DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  ContractWorker ContractWorker? @relation(fields: [workerId], references: [id])
}

model LoyaltyAccount {
  id        String   @id
  userId    String   @unique
  points    Int      @default(0)
  tier      String   @default("Bronze")
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

model OAuthConnection {
  id           String    @id
  userId       String
  service      String
  accessToken  String?
  refreshToken String?
  accountName  String?
  connected    Boolean   @default(false)
  lastSync     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  User         User      @relation(fields: [userId], references: [id])

  @@unique([userId, service])
}

model OAuthState {
  id        String   @id
  userId    String
  service   String
  state     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Order {
  id                   String                @id
  status               String                @default("pending")
  customerName         String
  total                Decimal               @db.Decimal(10, 2)
  userId               String?
  customerId           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  driverId             String?
  notes                String?
  User                 User?                 @relation(fields: [userId], references: [id])
  Customer             Customer?             @relation(fields: [customerId], references: [id])
  OrderItem            OrderItem[]
  tasks                Task[] // Picking/packing tasks for this order
  boxes                Box[] // Boxes for this order
  deliveryConfirmation DeliveryConfirmation?

  @@index([customerId])
}

model OrderItem {
  id        String   @id
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  orderId   String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Order     Order    @relation(fields: [orderId], references: [id])
  Product   Product  @relation(fields: [productId], references: [id])
}

model Product {
  id                 String                  @id @default(uuid())
  name               String
  sku                String                  @unique
  description        String?
  price              Decimal                 @db.Decimal(10, 2)
  inStock            Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime
  minStock           Int                     @default(10)
  stock              Int                     @default(0)
  supplier           String?                 @default("Default Supplier")
  cost               Decimal?                @db.Decimal(10, 2)
  imageUrl           String?                 @default("")
  margin             Decimal?                @db.Decimal(5, 2)
  backgroundColor    String?                 @default("#f3f4f6")
  brandId            String?
  categoryId         String?
  featured           Boolean                 @default(false)
  minOrderQty        Int                     @default(1)
  subcategoryId      String?
  unitType           String                  @default("case")
  unitsPerCase       Int                     @default(1)
  backgroundRemoved  Boolean                 @default(false)
  special            Boolean                 @default(false)
  splashImageUrl     String?                 @default("")
  gradientPresetId   String?
  glowPresetId       String?
  splashPresetId     String?
  seasonal           Boolean                 @default(false)
  trending           Boolean                 @default(false)
  backgroundGradient String?
  tier               String?
  priceTierA         Decimal?                @db.Decimal(10, 2)
  priceTierB         Decimal?                @db.Decimal(10, 2)
  priceTierC         Decimal?                @db.Decimal(10, 2)
  points             Int?                    @default(0)
  glossLevel         String?                 @default("none")
  sparkle            Boolean?                @default(false)
  badge              String?
  theme              String?                 @default("default")
  // Weekend Special fields (for grocery-style UI)
  isWeekendSpecial   Boolean                 @default(false)
  weekendPrice       Decimal?                @db.Decimal(10, 2)
  weekendStartDate   DateTime?
  weekendEndDate     DateTime?
  displayOrder       Int                     @default(0)
  warehouseLocation  String? // e.g., "A-12-3" (Aisle-Shelf-Bin)
  expirationDate     DateTime? // Product expiration date for inventory tracking
  lotNumber          String? // Batch/lot number for tracking
  caseSku            String? // Barcode/SKU on the case (different from individual unit SKU)
  allowPresell       Boolean                 @default(false) // Allow selling even when out of stock (for pre-orders)
  // Vendor & Cost fields
  vendorId           String? // Primary vendor for this product
  landedCost         Decimal?                @db.Decimal(10, 2) // Cost including shipping allocation
  suggestedPrice     Decimal?                @db.Decimal(10, 2) // System-suggested price based on margin
  // Master Case / Display fields (for DSD wholesale)
  sellByUnit         String                  @default("case") // "case", "display", "unit" - what we sell
  masterCaseUnits    Int? // How many sellable units in a master case
  displayUnits       Int? // Units per display (if selling by display)
  sellByPiece        Boolean                 @default(false) // Allow selling individual pieces
  sellByHalfCase     Boolean                 @default(false) // Allow selling half cases
  needsReview        Boolean                 @default(false) // Flag for new/updated products needing catalog review
  OrderItem          OrderItem[]
  Brand              Brand?                  @relation(fields: [brandId], references: [id])
  Category           Category?               @relation(fields: [categoryId], references: [id])
  Subcategory        Subcategory?            @relation(fields: [subcategoryId], references: [id])
  Vendor             Vendor?                 @relation(fields: [vendorId], references: [id])
  vendorSkuMappings  VendorSkuMapping[]
  PurchaseOrderItem  PurchaseOrderItem[]
  workOrders         WorkOrder[]
  ProductBundle      ProductBundle[]         @relation("BundleProducts")
  SpecialOffer       SpecialOffer[]          @relation("OfferProducts")
  Promotion          Promotion[]             @relation("PromotionProducts")
  sectionItems       CatalogSectionItem[]
  blockProducts      CatalogBlockProduct[]
  cartBlockProducts  CartBlockProduct[]
  boxItems           BoxItem[] // Items packed in boxes
  priceOverrides     CustomerPriceOverride[]

  @@index([isWeekendSpecial])
  @@index([displayOrder])
}

model ProductBundle {
  id              String    @id
  name            String
  slug            String    @unique
  description     String?
  imageUrl        String?
  badgeText       String?
  badgeColor      String?   @default("#10b981")
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  price           Decimal   @db.Decimal(10, 2)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  sku             String?
  stock           Int?      @default(0)
  inStock         Boolean?  @default(true)
  minStock        Int?      @default(5)
  featured        Boolean?  @default(false)
  businessModes   String[]  @default([])
  categoryId      String?
  brandId         String?
  Product         Product[] @relation("BundleProducts")
}

model Promotion {
  id              String    @id
  title           String
  description     String?
  discountPercent Decimal   @db.Decimal(5, 2)
  startDate       DateTime
  endDate         DateTime
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Product         Product[] @relation("PromotionProducts")
}

// ============================================
// VENDOR & PURCHASE ORDER SYSTEM
// ============================================

model Vendor {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String?  @unique // Short code like "SAB" for Sabritas
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  paymentTerms String? // "Net 30", "COD", etc.
  leadTimeDays Int      @default(7)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  purchaseOrders PurchaseOrder[]
  skuMappings    VendorSkuMapping[]
  products       Product[]

  @@index([active])
  @@index([name])
}

model VendorSkuMapping {
  id          String   @id @default(uuid())
  vendorId    String
  vendorSku   String // Vendor's SKU on their PO
  internalSku String // Our internal SKU
  productId   String? // Direct link to product
  confidence  Float    @default(1.0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  vendor  Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@unique([vendorId, vendorSku])
  @@index([vendorId])
  @@index([internalSku])
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  poNumber     String?   @unique // Vendor's PO number from PDF
  vendorId     String?
  supplier     String? // Legacy field for backwards compatibility
  status       POStatus  @default(PENDING)
  pdfUrl       String? // Uploaded PDF path
  subtotal     Decimal   @default(0) @db.Decimal(10, 2)
  shippingCost Decimal   @default(0) @db.Decimal(10, 2)
  total        Decimal   @default(0) @db.Decimal(10, 2)
  expectedDate DateTime?
  receivedDate DateTime?
  receivedById String? // Employee who received
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor        Vendor?             @relation(fields: [vendorId], references: [id])
  receivedBy    Employee?           @relation(fields: [receivedById], references: [id])
  items         PurchaseOrderItem[]
  receivingTask Task?               @relation("POReceivingTask")

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

enum POStatus {
  PENDING // Just uploaded, not yet confirmed
  CONFIRMED // Ana confirmed, waiting for delivery
  IN_TRANSIT // Shipment on the way
  RECEIVING // Employee actively receiving
  RECEIVED // All items received
  STOCKED // Items put away in warehouse
  CANCELLED
}

model PurchaseOrderItem {
  id                String    @id @default(uuid())
  purchaseOrderId   String
  productId         String? // Null if new product not yet created
  vendorSku         String
  description       String
  quantityOrdered   Int
  quantityReceived  Int       @default(0)
  unitCost          Decimal   @db.Decimal(10, 2)
  totalCost         Decimal   @db.Decimal(10, 2)
  unitsPerCase      Int       @default(1) // Master case contains X sellable units
  sellableUnits     Int? // How many sellable units (for master case products)
  isNewProduct      Boolean   @default(false)
  needsReview       Boolean   @default(false) // Flagged for review
  receivedAt        DateTime?
  lotNumber         String?
  expirationDate    DateTime?
  warehouseLocation String?
  notes             String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([vendorSku])
}

model Reward {
  id          String  @id
  title       String
  description String
  cost        Int
  imageUrl    String?
  active      Boolean @default(true)
}

model SalesRep {
  id             String     @id
  name           String
  email          String     @unique
  phone          String?
  territory      String?
  uniqueLinkCode String     @unique
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  // User account link (for login/auth)
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id])
  // Customers assigned to this sales rep
  customers      Customer[]
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
}

model SpecialOffer {
  id          String    @id
  title       String
  description String?
  imageUrl    String?
  ctaText     String    @default("Shop Now")
  ctaLink     String?
  validUntil  DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Product     Product[] @relation("OfferProducts")
}

model Subcategory {
  id           String    @id
  name         String
  description  String?
  displayOrder Int       @default(0)
  categoryId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Product      Product[]
  Category     Category  @relation(fields: [categoryId], references: [id])
}

model User {
  id                     String                  @id
  email                  String                  @unique
  name                   String
  role                   String                  @default("CUSTOMER")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  password               String                  @default("")
  ApiKey                 ApiKey[]
  ContractWorker         ContractWorker?
  LoyaltyAccount         LoyaltyAccount?
  OAuthConnection        OAuthConnection[]
  Order                  Order[]
  Session                Session[]
  UserBadge              UserBadge[]
  SalesRep               SalesRep?
  activities             EmployeeActivity[]
  createdPriceOverrides  CustomerPriceOverride[] @relation("PriceOverrideCreator")
  approvedPriceOverrides CustomerPriceOverride[] @relation("PriceOverrideApprover")
}

model UserBadge {
  id       String   @id
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  Badge    Badge    @relation(fields: [badgeId], references: [id])
  User     User     @relation(fields: [userId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_REP
  WAREHOUSE
  DRIVER
  CUSTOMER
}

// ============================================
// CATALOG SECTION SYSTEM (Alessa-style layout)
// ============================================

model CatalogSection {
  id          String               @id @default(uuid())
  name        String
  description String?
  type        CatalogSectionType   @default(GROCERY)
  position    Int                  @default(0)
  hero        Boolean              @default(false)
  imageUrl    String?
  badgeText   String?
  badgeColor  String?              @default("#10b981")
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       CatalogSectionItem[]

  @@index([position])
  @@index([active])
}

model CatalogSectionItem {
  id           String         @id @default(uuid())
  sectionId    String
  productId    String
  displayOrder Int            @default(0)
  featured     Boolean        @default(false)
  section      CatalogSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@unique([sectionId, productId])
  @@index([sectionId])
  @@index([displayOrder])
}

enum CatalogSectionType {
  GROCERY
  CHIPS
  CANDY
  BEVERAGES
  SEASONAL
  SPECIAL
  BUNDLES
  FEATURED
  BAKERY
  DAIRY
  OTHER
}

// ============================================
// CATALOG BLOCK BUILDER SYSTEM
// ============================================

model CatalogSettings {
  id                 String   @id @default("default")
  backgroundGradient String   @default("linear-gradient(180deg, #0f3d0f 0%, #1a4d1a 50%, #0d2e0d 100%)")
  backgroundPattern  String?
  patternOpacity     Float    @default(0.1)
  patternSize        String?  @default("40px 40px")
  headerStyle        String   @default("default")
  primaryColor       String   @default("#d4a853")
  secondaryColor     String   @default("#059669")
  animation          String? // pulse, shimmer, gradient-shift, aurora
  glowEffect         Boolean  @default(false)
  particleEffect     String? // confetti, sparkle, etc
  updatedAt          DateTime @updatedAt
}

model CatalogBlock {
  id        String                @id @default(uuid())
  type      CatalogBlockType      @default(PRODUCT_GRID)
  title     String?
  subtitle  String?
  badgeText String?
  ctaText   String?
  ctaLink   String?
  config    Json                  @default("{}")
  position  Int                   @default(0)
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  products  CatalogBlockProduct[]

  @@index([position])
  @@index([active])
}

model CatalogBlockProduct {
  id           String       @id @default(uuid())
  blockId      String
  productId    String
  displayOrder Int          @default(0)
  block        CatalogBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([blockId, productId])
  @@index([blockId])
  @@index([displayOrder])
}

enum CatalogBlockType {
  HERO
  PRODUCT_GRID
  PRODUCT_CARDS
  BANNER
  CATEGORY_ROW
  PROMO_SECTION
  // DSD Wholesale Block Types
  RACK_BUNDLE
  VENDOR_SPOTLIGHT
  CASE_DEAL
  NEW_ARRIVALS
  QUICK_REORDER
  BULK_BUILDER
  SEASONAL_THEME
  BRAND_SHOWCASE
  // Creative/Visual Block Types
  CHARACTER_STAGE
}

// ============================================
// BUSINESS SETTINGS (Singleton)
// ============================================

model BusinessSettings {
  id                 String   @id @default("default")
  name               String   @default("Azteka DSD")
  address            String   @default("")
  city               String   @default("")
  state              String   @default("TX")
  zipCode            String   @default("")
  phone              String   @default("")
  email              String   @default("")
  website            String   @default("")
  taxId              String   @default("")
  warehouseAddress   String   @default("")
  warehouseCity      String   @default("")
  warehouseState     String   @default("TX")
  warehouseZipCode   String   @default("")
  deliveryRadius     Int      @default(50)
  businessHoursOpen  String   @default("06:00")
  businessHoursClose String   @default("18:00")
  businessDays       String   @default("Mon-Sat")
  cartBlocksConfig   Json? // JSON config for cart checkout blocks
  updatedAt          DateTime @updatedAt
}

// ============================================
// CART BLOCK SYSTEM (for cart drawer UI)
// ============================================

model CartBlock {
  id        String        @id @default(uuid())
  type      CartBlockType
  title     String?
  config    Json          @default("{}")
  position  Int           @default(0)
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  products  CartBlockProduct[]

  @@index([position])
  @@index([enabled])
}

model CartBlockProduct {
  id           String    @id @default(uuid())
  blockId      String
  productId    String
  displayOrder Int       @default(0)
  block        CartBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@unique([blockId, productId])
  @@index([blockId])
}

enum CartBlockType {
  CART_ITEMS       // Current cart contents (always shown)
  COMPLETE_ORDER   // Upsell suggestions based on cart
  TRENDING_NOW     // Popular products to add
  PREVIOUSLY_ORDERED // Customer's past purchases
  BUNDLE_PROGRESS  // Progress toward bundle deals
  REWARDS_STATUS   // Points balance and rewards
}

// ============================================
// REWARDS SYSTEM (Domino's style)
// ============================================

model RewardTier {
  id         String   @id @default(uuid())
  name       String   // "Bronze", "Silver", "Gold", "Platinum"
  minSpend   Decimal  @db.Decimal(10, 2) // Min monthly spend to qualify
  color      String   // Tier color for UI
  multiplier Float    @default(1.0) // Points multiplier
  position   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([position])
}

model RewardPrize {
  id          String   @id @default(uuid())
  name        String   // "Free Case of Takis"
  description String?
  imageUrl    String?
  pointsCost  Int      // Points to redeem
  stock       Int      @default(0) // Available quantity
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TradeOffDeal {
  id                String   @id @default(uuid())
  name              String   // "Electrolit at Cost"
  description       String?
  rewardProductId   String?  // Product they get at special price
  rewardBrandId     String?  // Or brand they get at special price
  rewardPrice       Decimal  @db.Decimal(10, 2) // Special price
  rewardMaxQty      Int      // Max units at this price
  requirementType   String   // "MIN_ORDER", "MIN_AVERAGE", "EXCLUDE_BRAND"
  minSpend          Decimal  @db.Decimal(10, 2) // Min $ to qualify
  excludeBrandId    String?  // Brand to exclude from calculation
  excludeCategoryId String?  // Category to exclude
  active            Boolean  @default(true)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active])
}

// ============================================
// CATEGORY & BRAND LAYOUT BLOCKS
// ============================================

model CategoryLayout {
  id          String   @id @default(uuid())
  categoryId  String   @unique
  config      Json     @default("{}") // Layout configuration
  heroImage   String?
  heroTitle   String?
  heroSubtitle String?
  showSubcategories Boolean @default(true)
  showBundles Boolean @default(true)
  gridColumns Int     @default(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model BrandLayout {
  id          String   @id @default(uuid())
  brandId     String   @unique
  config      Json     @default("{}") // Layout configuration
  heroImage   String?
  heroGradient String?
  showLogo    Boolean  @default(true)
  featured    Boolean  @default(false)
  gridColumns Int      @default(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

// ============================================
// EMPLOYEE TIME CLOCK SYSTEM
// ============================================

model Employee {
  id           String          @id @default(uuid())
  firstName    String
  lastName     String
  phone        String          @unique // Full phone number
  pin          String // Last 4 digits of phone (for kiosk login)
  email        String?         @unique
  role         EmployeeRole    @default(WAREHOUSE)
  hourlyRate   Decimal         @default(0) @db.Decimal(10, 2)
  active       Boolean         @default(true)
  photoUrl     String? // Profile photo
  hireDate     DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  timeEntries  TimeEntry[]
  tasks        Task[] // Assigned tasks
  receivedPOs  PurchaseOrder[] // POs this employee received
  workOrders   WorkOrder[] // Work orders assigned to this employee
  activityLogs ActivityLog[]   @relation("EmployeeActivityLogs")

  @@index([pin])
  @@index([active])
}

model TimeEntry {
  id            String          @id @default(uuid())
  employeeId    String
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn       DateTime
  clockOut      DateTime?
  clockInPhoto  String? // Photo URL taken at clock-in
  clockOutPhoto String? // Photo URL taken at clock-out
  hoursWorked   Decimal?        @db.Decimal(5, 2) // Calculated on clock-out
  notes         String?
  status        TimeEntryStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([employeeId])
  @@index([clockIn])
  @@index([status])
}

enum EmployeeRole {
  WAREHOUSE
  DRIVER
  OFFICE
  MANAGER
}

enum TimeEntryStatus {
  ACTIVE // Currently clocked in
  COMPLETED // Clocked out normally
  ADJUSTED // Manually adjusted by admin
}

// Employee Activity Log - tracks all work activities for worksheets
model EmployeeActivity {
  id String @id @default(cuid())

  // Who did the action
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What type of action
  actionType ActivityType

  // Reference to related entity (productId, orderId, etc.)
  entityType String? // "product", "order", "delivery", etc.
  entityId   String? // The ID of the related entity
  entityName String? // Human-readable name (product name, order #, etc.)

  // Details of what was done
  description String // Human-readable description
  metadata    Json? // Additional structured data (old/new values, quantities, etc.)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum ActivityType {
  // Inventory actions
  STOCK_UPDATE // Changed stock quantity
  LOCATION_UPDATE // Changed warehouse location
  SKU_UPDATE // Updated product SKU
  EXPIRATION_UPDATE // Set/changed expiration date
  IMAGE_UPLOAD // Uploaded product image
  PRODUCT_CLASSIFY // Changed category/brand

  // Order actions
  ORDER_PICKED // Picked an order item
  ORDER_PACKED // Packed an order
  ORDER_STATUS_CHANGE // Changed order status

  // Delivery actions
  DELIVERY_START // Started a delivery route
  DELIVERY_COMPLETE // Completed a delivery
  DELIVERY_ISSUE // Reported delivery issue

  // Receiving actions
  SHIPMENT_RECEIVE // Received incoming shipment
  STOCK_COUNT // Performed inventory count

  // Time clock
  CLOCK_IN // Clocked in
  CLOCK_OUT // Clocked out

  // Picking & Packing
  PICK_STARTED // Started picking an order
  PICK_ITEM // Picked an individual item
  PICK_COMPLETED // Completed picking entire order
  BOX_CREATED // Created a new box for packing
  BOX_SEALED // Sealed a box for delivery
}

// ============================================
// TASK MANAGEMENT SYSTEM (for auto-workflow)
// ============================================

model Task {
  id          String   @id @default(uuid())
  type        TaskType @default(PICKING)
  title       String
  description String?

  // Assignment
  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])

  // Related order (if applicable)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Related purchase order (for receiving tasks)
  purchaseOrderId String?        @unique
  purchaseOrder   PurchaseOrder? @relation("POReceivingTask", fields: [purchaseOrderId], references: [id])

  // Status tracking
  status   TaskStatus   @default(PENDING)
  priority TaskPriority @default(NORMAL)

  // Timestamps
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // Completion notes
  notes String?

  // Auto-print tracking
  autoPrinted Boolean @default(false)
  printJobId  String? // Reference to PrintJob if printed

  @@index([assigneeId])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

enum TaskType {
  PICKING // Pick items for an order
  PACKING // Pack items into boxes
  RECEIVING // Receive incoming inventory
  STOCKING // Stock items on shelves
  DELIVERY // Deliver to customer
  COUNTING // Inventory count
}

enum TaskStatus {
  PENDING // Not started
  ASSIGNED // Assigned to employee
  IN_PROGRESS // Being worked on
  COMPLETED // Done
  CANCELLED // Cancelled
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================
// ACTIVITY LOG (simple audit trail)
// ============================================

model ActivityLog {
  id          String @id @default(uuid())
  type        String // e.g., "RECEIVING_CLAIMED", "ITEM_RECEIVED", "RECEIVING_COMPLETED"
  description String
  metadata    Json?

  // Who performed the action
  employeeId String?
  employee   Employee? @relation("EmployeeActivityLogs", fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// BOX & QR CODE SYSTEM (for delivery tracking)
// ============================================

model Box {
  id String @id @default(uuid())

  // Order relationship
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // QR code for scanning
  qrCode String @unique // Unique identifier for QR

  // Contents
  items BoxItem[]

  // Status
  status BoxStatus @default(PACKING)

  // Timestamps
  createdAt   DateTime  @default(now())
  sealedAt    DateTime?
  deliveredAt DateTime?

  // Who packed it
  packedById String?

  @@index([orderId])
  @@index([qrCode])
  @@index([status])
}

model BoxItem {
  id String @id @default(uuid())

  boxId String
  box   Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  // Track if picked/confirmed
  picked Boolean @default(false)

  @@index([boxId])
  @@index([productId])
}

enum BoxStatus {
  PACKING // Being packed
  SEALED // Sealed and ready
  IN_TRANSIT // On delivery truck
  DELIVERED // Delivered to customer
}

// ============================================
// DELIVERY CONFIRMATION SYSTEM
// ============================================

model DeliveryConfirmation {
  id String @id @default(uuid())

  // Order relationship
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  // Secure token for customer access (no login required)
  token String @unique @default(uuid())

  // Signatures (base64 encoded images)
  driverSignature   String? @db.Text
  customerSignature String? @db.Text

  // Item confirmation (JSON array)
  confirmedItems Json? // [{productId, confirmed: bool, issue?: string, photoUrl?: string}]

  // Driver info (who initiated the delivery)
  driverName String?
  driverId   String?

  // Customer info
  customerName  String?
  customerPhone String?

  // Notes and issues
  notes     String? @db.Text
  hasIssues Boolean @default(false)

  // Timestamps
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([token])
  @@index([orderId])
}

// ============================================
// PRINT JOB QUEUE (for auto-printing)
// ============================================

model PrintJob {
  id String @id @default(uuid())

  // Type of document
  type PrintJobType

  // Printer info
  printerId String? // Printer ID/name

  // Content
  payload Json // Document data to print

  // Status
  status PrintJobStatus @default(QUEUED)
  copies Int            @default(1)

  // Reference to what triggered the print
  sourceType String? // "order", "task", "box"
  sourceId   String?

  // Timestamps
  createdAt DateTime  @default(now())
  printedAt DateTime?

  // Error info if failed
  errorMsg String?
  retries  Int     @default(0)

  @@index([status])
  @@index([createdAt])
}

enum PrintJobType {
  PICKING_LIST // List of items to pick
  PACKING_SLIP // Slip to include in box
  BOX_LABEL // QR code label for box
  INVOICE // Customer invoice
  DELIVERY_SHEET // Driver delivery manifest
}

enum PrintJobStatus {
  QUEUED // Waiting to print
  PRINTING // Currently printing
  COMPLETED // Successfully printed
  FAILED // Print failed
  CANCELLED // Cancelled
}

// Print Agent registration (local print agents that poll for jobs)
model PrintAgent {
  id            String   @id @default(uuid())
  name          String   @unique // e.g., "warehouse-mac"
  secret        String   // API key for authentication
  lastHeartbeat DateTime?
  printerStatus String   @default("UNKNOWN") // ONLINE, OFFLINE, ERROR, UNKNOWN
  printerName   String?  // e.g., "HP_Color_LaserJet_MFP_M281fdw"
  queueDepth    Int      @default(0)
  lastError     String?
  ipAddress     String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([lastHeartbeat])
}

// ============================================
// CUSTOMER GROUPS (for multi-account reporting)
// ============================================

model CustomerGroup {
  id    String  @id @default(uuid())
  name  String
  email String // Primary contact email for reports
  phone String?
  notes String?

  // Customers in this group
  customers Customer[] @relation("CustomerGroupMembers")

  // Report settings
  sendWeeklyReport Boolean @default(true)
  reportDay        Int     @default(1) // 0=Sunday, 1=Monday, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================
// WORK ORDER SYSTEM (for catalog/admin tasks)
// ============================================

model WorkOrder {
  id          String          @id @default(uuid())
  type        WorkOrderType
  title       String
  description String?
  status      WorkOrderStatus @default(PENDING)
  priority    TaskPriority    @default(NORMAL)

  // Assignment (optional - for Ernesto or other admin)
  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])

  // Related product (for NEW_PRODUCT_CATALOG, PRICE_UPDATE, IMAGE_NEEDED)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // Related PO (for receiving-triggered work orders)
  purchaseOrderId String?

  // Extra data (vendor info, suggested price, etc)
  metadata Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([type])
  @@index([assigneeId])
  @@index([productId])
  @@index([createdAt])
}

enum WorkOrderType {
  NEW_PRODUCT_CATALOG // New product needs to be added to catalog
  PRICE_UPDATE // Price needs review/update
  IMAGE_NEEDED // Product needs image
  INVENTORY_COUNT // Inventory count required
  VENDOR_SETUP // New vendor needs setup
}

enum WorkOrderStatus {
  PENDING // Not started
  IN_PROGRESS // Being worked on
  COMPLETED // Done
  CANCELLED // Cancelled
}

// ============================================
// CUSTOMER PRICE OVERRIDE SYSTEM
// ============================================

model CustomerPriceOverride {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Pricing Options
  overrideType    OverrideType @default(FIXED_PRICE)
  fixedPrice      Decimal?     @db.Decimal(10, 2) // Fixed price override
  discountPercent Decimal?     @db.Decimal(5, 2) // Percentage discount (e.g., 10 = 10% off)
  discountAmount  Decimal?     @db.Decimal(10, 2) // Fixed discount amount

  // Tiered Pricing (for volume discounts)
  minQuantity Int? // Minimum quantity for this price
  maxQuantity Int? // Maximum quantity (null = unlimited)

  // Contract/Agreement
  contractNumber String?
  notes          String?
  startDate      DateTime?
  endDate        DateTime? // Expiration date (null = no expiration)

  // Status
  active Boolean @default(true)

  // Audit Trail
  createdById  String
  createdBy    User     @relation("PriceOverrideCreator", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?    @relation("PriceOverrideApprover", fields: [approvedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([customerId, productId, minQuantity]) // Allow multiple tiers per product
  @@index([customerId])
  @@index([productId])
  @@index([active])
  @@index([endDate])
}

enum OverrideType {
  FIXED_PRICE // Set exact price: $22.99
  PERCENTAGE_DISCOUNT // 10% off standard price
  FIXED_DISCOUNT // $2.00 off standard price
  TIERED // Volume-based pricing
}
