generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String   @id
  userId    String
  service   String
  key       String
  status    String   @default("disconnected")
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, service])
}

model Badge {
  id          String      @id
  name        String
  description String
  points      Int         @default(0)
  iconUrl     String?
  UserBadge   UserBadge[]
}

model Brand {
  id           String       @id
  name         String
  logoUrl      String?
  description  String?
  isFeatured   Boolean      @default(false)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  slug         String?      @unique
  imageUrl     String?
  Product      Product[]
  layout       BrandLayout?
}

model Category {
  id           String          @id
  name         String
  slug         String          @unique
  description  String?
  imageUrl     String?
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime
  Product      Product[]
  Subcategory  Subcategory[]
  layout       CategoryLayout?
}

model ContractWorker {
  id        String   @id
  userId    String   @unique
  type      String
  active    Boolean  @default(true)
  earnings  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
  Job       Job[]
}

model Customer {
  id                 String                  @id
  businessName       String
  contactName        String
  email              String                  @unique
  phone              String
  address            String
  city               String
  state              String
  zipCode            String
  salesRepId         String?
  salesRep           SalesRep?               @relation(fields: [salesRepId], references: [id])
  active             Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime
  // Pricing tier (A=best, B=standard, C=basic)
  priceTier          String                  @default("B")
  // Geolocation for route optimization
  latitude           Float?
  longitude          Float?
  // Visit scheduling
  visitFrequency     String?                 @default("weekly") // 3x_week, 2x_week, weekly, biweekly
  preferredDays      String[]                @default([]) // ["monday", "thursday"]
  lastVisitDate      DateTime?
  nextScheduledVisit DateTime?
  // Customer group for multi-account reporting
  groupId            String?
  group              CustomerGroup?          @relation("CustomerGroupMembers", fields: [groupId], references: [id])

  // ===== CUSTOMER PORTAL FIELDS =====
  // Authentication
  pin                String?                 // 4-6 digit PIN for login (hashed)
  // Role for multi-store hierarchy
  role               CustomerRole            @default(STANDARD)
  // Multi-store: link sub-stores to parent owner
  parentCustomerId   String?
  parentCustomer     Customer?               @relation("CustomerHierarchy", fields: [parentCustomerId], references: [id])
  subStores          Customer[]              @relation("CustomerHierarchy")
  // Sessions and messages
  sessions           CustomerSession[]
  sentMessages       CustomerMessage[]       @relation("CustomerSentMessages")
  receivedMessages   CustomerMessage[]       @relation("CustomerReceivedMessages")

  // Price overrides
  priceOverrides     CustomerPriceOverride[]
  // Orders
  orders             Order[]

  // CRM relations
  productRequests    ProductRequest[]
  surveys            CustomerSurvey[]
  documents          CustomerDocument[]
}

enum CustomerRole {
  STANDARD    // Regular customer - single store
  OWNER       // Multi-store owner (like Carlo)
  MANAGER     // Sub-manager of a multi-store owner
}

// Customer session for magic links and PIN login
model CustomerSession {
  id           String              @id @default(uuid())
  customerId   String
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token        String              @unique // Magic link token or session token
  type         CustomerSessionType @default(MAGIC_LINK)
  // Link purpose for analytics and routing
  linkPurpose  CustomerLinkPurpose?
  // Who created this session (rep ID for magic links, null for PIN login)
  createdById  String?
  // Expiration (12hr inactivity or on order completion)
  expiresAt    DateTime
  // Tracking
  usedAt       DateTime?           // When order was placed (invalidates magic link)
  lastActiveAt DateTime            @default(now()) // For inactivity tracking
  createdAt    DateTime            @default(now())
  // Link analytics events
  linkEvents   CustomerLinkEvent[]

  @@index([token])
  @@index([customerId])
  @@index([expiresAt])
  @@index([linkPurpose])
}

enum CustomerSessionType {
  MAGIC_LINK  // Sent by sales rep
  PIN_LOGIN   // Customer logged in with phone + PIN
  DELEGATED   // Multi-store owner delegated to sub-manager
}

// Purpose of customer link for routing and analytics
enum CustomerLinkPurpose {
  HANDOFF       // Rep hands tablet to customer (favorites in menu)
  INSTALL       // App install/onboarding link
  CATALOG_SHARE // Direct catalog access link
}

// ============================================
// CUSTOMER LINK ANALYTICS SYSTEM
// ============================================

// Event tracking for customer link interactions
model CustomerLinkEvent {
  id           String               @id @default(uuid())
  // Link context
  sessionId    String
  session      CustomerSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId   String
  // Event details
  eventType    CustomerEventType
  eventData    Json?                // Extra data (productId, categoryId, search query, etc.)
  // Device & context
  deviceType   String?              // mobile, tablet, desktop
  userAgent    String?
  // Timestamps
  createdAt    DateTime             @default(now())

  @@index([sessionId])
  @@index([customerId])
  @@index([eventType])
  @@index([createdAt])
}

enum CustomerEventType {
  // Session events
  LINK_OPENED
  SESSION_STARTED
  SESSION_ENDED
  // Engagement events
  SCROLL_DEPTH
  TIME_ON_PAGE
  // Navigation events
  CATEGORY_VIEWED
  BRAND_VIEWED
  SEARCH_PERFORMED
  PRODUCT_VIEWED
  // Cart events
  PRODUCT_ADDED
  PRODUCT_REMOVED
  QUANTITY_CHANGED
  CART_OPENED
  // Conversion events
  CHECKOUT_STARTED
  ORDER_PLACED
  // Onboarding events (INSTALL links only)
  PWA_PROMPT_SHOWN
  PWA_INSTALLED
  PIN_CREATED
  ONBOARDING_COMPLETED
}

// Aggregated session analytics (computed periodically)
model CustomerLinkAnalytics {
  id                    String   @id @default(uuid())
  customerId            String
  // Period
  periodStart           DateTime
  periodEnd             DateTime
  // Engagement metrics
  totalLinkOpens        Int      @default(0)
  handoffLinkOpens      Int      @default(0)
  installLinkOpens      Int      @default(0)
  catalogShareOpens     Int      @default(0)
  // Attention metrics
  totalTimeOnPageMs     BigInt   @default(0)
  avgSessionDurationMs  BigInt   @default(0)
  avgScrollDepth        Float    @default(0)
  // Browse metrics
  productsViewed        Int      @default(0)
  categoriesBrowsed     Int      @default(0)
  searchesPerformed     Int      @default(0)
  // Cart metrics
  productsAdded         Int      @default(0)
  productsRemoved       Int      @default(0)
  // Conversion metrics
  ordersPlaced          Int      @default(0)
  orderValue            Decimal  @default(0) @db.Decimal(10, 2)
  conversionRate        Float    @default(0)
  // PWA metrics
  pwaPromptsShown       Int      @default(0)
  pwaInstalls           Int      @default(0)
  pinsCreated           Int      @default(0)
  // Timestamps
  updatedAt             DateTime @updatedAt

  @@unique([customerId, periodStart, periodEnd])
  @@index([customerId])
  @@index([periodStart])
}

// Customer messages for support chat
model CustomerMessage {
  id              String    @id @default(uuid())
  // Sender (either customer or null if from rep/admin)
  senderId        String?
  sender          Customer? @relation("CustomerSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  // Recipient customer (for messages from rep to customer)
  recipientId     String?
  recipient       Customer? @relation("CustomerReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  // If from sales rep or admin, store their ID
  repId           String?
  // Message content
  message         String    @db.Text
  // Read status
  readAt          DateTime?
  // Timestamps
  createdAt       DateTime  @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([repId])
  @@index([createdAt])
}

model Incentive {
  id          String   @id
  title       String
  description String
  threshold   Int
  reward      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
}

model Invoice {
  id          String    @id
  supplier    String
  invoiceDate DateTime?
  fileUrl     String
  status      String    @default("processed")
  total       Decimal   @default(0) @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
}

model Job {
  id             String          @id
  type           String
  title          String
  description    String
  location       String?
  commission     Decimal         @db.Decimal(10, 2)
  status         String          @default("available")
  workerId       String?
  deadline       DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  ContractWorker ContractWorker? @relation(fields: [workerId], references: [id])
}

model LoyaltyAccount {
  id        String   @id
  userId    String   @unique
  points    Int      @default(0)
  tier      String   @default("Bronze")
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

model OAuthConnection {
  id           String    @id
  userId       String
  service      String
  accessToken  String?
  refreshToken String?
  accountName  String?
  connected    Boolean   @default(false)
  lastSync     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  User         User      @relation(fields: [userId], references: [id])

  @@unique([userId, service])
}

model OAuthState {
  id        String   @id
  userId    String
  service   String
  state     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Order {
  id                   String                @id
  status               String                @default("pending")
  customerName         String
  total                Decimal               @db.Decimal(10, 2)
  userId               String?
  customerId           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  driverId             String?
  notes                String?
  User                 User?                 @relation(fields: [userId], references: [id])
  Customer             Customer?             @relation(fields: [customerId], references: [id])
  OrderItem            OrderItem[]
  tasks                Task[] // Picking/packing tasks for this order
  boxes                Box[] // Boxes for this order
  deliveryConfirmation DeliveryConfirmation?

  @@index([customerId])
}

model OrderItem {
  id        String   @id
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  orderId   String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Order     Order    @relation(fields: [orderId], references: [id])
  Product   Product  @relation(fields: [productId], references: [id])
}

model Product {
  id                 String                  @id @default(uuid())
  name               String
  sku                String                  @unique
  description        String?
  price              Decimal                 @db.Decimal(10, 2)
  inStock            Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime
  minStock           Int                     @default(10)
  stock              Int                     @default(0)
  supplier           String?                 @default("Default Supplier")
  cost               Decimal?                @db.Decimal(10, 2)
  imageUrl           String?                 @default("")
  margin             Decimal?                @db.Decimal(5, 2)
  backgroundColor    String?                 @default("#f3f4f6")
  brandId            String?
  categoryId         String?
  featured           Boolean                 @default(false)
  minOrderQty        Int                     @default(1)
  subcategoryId      String?
  unitType           String                  @default("case")
  unitsPerCase       Int                     @default(1)
  backgroundRemoved  Boolean                 @default(false)
  special            Boolean                 @default(false)
  splashImageUrl     String?                 @default("")
  gradientPresetId   String?
  glowPresetId       String?
  splashPresetId     String?
  seasonal           Boolean                 @default(false)
  trending           Boolean                 @default(false)
  backgroundGradient String?
  tier               String?
  priceTierA         Decimal?                @db.Decimal(10, 2)
  priceTierB         Decimal?                @db.Decimal(10, 2)
  priceTierC         Decimal?                @db.Decimal(10, 2)
  points             Int?                    @default(0)
  glossLevel         String?                 @default("none")
  sparkle            Boolean?                @default(false)
  badge              String?
  theme              String?                 @default("default")
  // Weekend Special fields (for grocery-style UI)
  isWeekendSpecial   Boolean                 @default(false)
  weekendPrice       Decimal?                @db.Decimal(10, 2)
  weekendStartDate   DateTime?
  weekendEndDate     DateTime?
  displayOrder       Int                     @default(0)
  warehouseLocation  String? // e.g., "A-12-3" (Aisle-Shelf-Bin)
  expirationDate     DateTime? // Product expiration date for inventory tracking
  lotNumber          String? // Batch/lot number for tracking
  caseSku            String? // Barcode/SKU on the case (different from individual unit SKU)
  allowPresell       Boolean                 @default(false) // Allow selling even when out of stock (for pre-orders)
  // Vendor & Cost fields
  vendorId           String? // Primary vendor for this product
  landedCost         Decimal?                @db.Decimal(10, 2) // Cost including shipping allocation
  suggestedPrice     Decimal?                @db.Decimal(10, 2) // System-suggested price based on margin
  // Master Case / Display fields (for DSD wholesale)
  sellByUnit         String                  @default("case") // "case", "display", "unit" - what we sell
  masterCaseUnits    Int? // How many sellable units in a master case
  displayUnits       Int? // Units per display (if selling by display)
  sellByPiece        Boolean                 @default(false) // Allow selling individual pieces
  sellByHalfCase     Boolean                 @default(false) // Allow selling half cases
  needsReview        Boolean                 @default(false) // Flag for new/updated products needing catalog review
  OrderItem          OrderItem[]
  Brand              Brand?                  @relation(fields: [brandId], references: [id])
  Category           Category?               @relation(fields: [categoryId], references: [id])
  Subcategory        Subcategory?            @relation(fields: [subcategoryId], references: [id])
  Vendor             Vendor?                 @relation(fields: [vendorId], references: [id])
  vendorSkuMappings  VendorSkuMapping[]
  PurchaseOrderItem  PurchaseOrderItem[]
  workOrders         WorkOrder[]
  ProductBundle      ProductBundle[]         @relation("BundleProducts")
  SpecialOffer       SpecialOffer[]          @relation("OfferProducts")
  Promotion          Promotion[]             @relation("PromotionProducts")
  sectionItems       CatalogSectionItem[]
  blockProducts      CatalogBlockProduct[]
  cartBlockProducts  CartBlockProduct[]
  boxItems           BoxItem[] // Items packed in boxes
  priceOverrides     CustomerPriceOverride[]

  @@index([isWeekendSpecial])
  @@index([displayOrder])
}

model ProductBundle {
  id              String    @id
  name            String
  slug            String    @unique
  description     String?
  imageUrl        String?
  badgeText       String?
  badgeColor      String?   @default("#10b981")
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  price           Decimal   @db.Decimal(10, 2)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  sku             String?
  stock           Int?      @default(0)
  inStock         Boolean?  @default(true)
  minStock        Int?      @default(5)
  featured        Boolean?  @default(false)
  businessModes   String[]  @default([])
  categoryId      String?
  brandId         String?
  Product         Product[] @relation("BundleProducts")
}

model Promotion {
  id              String    @id
  title           String
  description     String?
  discountPercent Decimal   @db.Decimal(5, 2)
  startDate       DateTime
  endDate         DateTime
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Product         Product[] @relation("PromotionProducts")
}

// ============================================
// VENDOR & PURCHASE ORDER SYSTEM
// ============================================

model Vendor {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String?  @unique // Short code like "SAB" for Sabritas
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  paymentTerms String? // "Net 30", "COD", etc.
  leadTimeDays Int      @default(7)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  purchaseOrders   PurchaseOrder[]
  skuMappings      VendorSkuMapping[]
  products         Product[]
  shippingExpenses ShippingExpense[]

  @@index([active])
  @@index([name])
}

model VendorSkuMapping {
  id          String   @id @default(uuid())
  vendorId    String
  vendorSku   String // Vendor's SKU on their PO
  internalSku String // Our internal SKU
  productId   String? // Direct link to product
  confidence  Float    @default(1.0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  vendor  Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@unique([vendorId, vendorSku])
  @@index([vendorId])
  @@index([internalSku])
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  poNumber     String?   @unique // Vendor's PO number from PDF
  vendorId     String?
  supplier     String? // Legacy field for backwards compatibility
  status       POStatus  @default(PENDING)
  pdfUrl       String? // Uploaded PDF path
  subtotal     Decimal   @default(0) @db.Decimal(10, 2)
  shippingCost Decimal   @default(0) @db.Decimal(10, 2)
  total        Decimal   @default(0) @db.Decimal(10, 2)
  expectedDate DateTime?
  receivedDate DateTime?
  receivedById String? // Employee who received
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor           Vendor?             @relation(fields: [vendorId], references: [id])
  receivedBy       Employee?           @relation(fields: [receivedById], references: [id])
  items            PurchaseOrderItem[]
  receivingTask    Task?               @relation("POReceivingTask")
  shippingExpenses ShippingExpense[]

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

enum POStatus {
  PENDING // Just uploaded, not yet confirmed
  CONFIRMED // Ana confirmed, waiting for delivery
  IN_TRANSIT // Shipment on the way
  RECEIVING // Employee actively receiving
  RECEIVED // All items received
  STOCKED // Items put away in warehouse
  CANCELLED
}

model PurchaseOrderItem {
  id                String    @id @default(uuid())
  purchaseOrderId   String
  productId         String? // Null if new product not yet created
  vendorSku         String
  description       String
  quantityOrdered   Int
  quantityReceived  Int       @default(0)
  unitCost          Decimal   @db.Decimal(10, 2)
  totalCost         Decimal   @db.Decimal(10, 2)
  unitsPerCase      Int       @default(1) // Master case contains X sellable units
  sellableUnits     Int? // How many sellable units (for master case products)
  isNewProduct      Boolean   @default(false)
  needsReview       Boolean   @default(false) // Flagged for review
  receivedAt        DateTime?
  lotNumber         String?
  expirationDate    DateTime?
  warehouseLocation String?
  notes             String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([vendorSku])
}

// Shipping/Freight expenses - separate from PO invoice
// Tracks delivery costs that come on separate invoices
model ShippingExpense {
  id              String    @id @default(uuid())
  purchaseOrderId String?   // Link to PO (optional, for analysis)
  vendorId        String?   // Vendor/carrier for this shipment

  // Expense details
  invoiceNumber   String?   // Shipping invoice #
  invoiceDate     DateTime?
  deliveryDate    DateTime? // When the delivery arrived
  amount          Decimal   @db.Decimal(10, 2)

  // Carrier info
  carrierName     String?   // "FedEx Freight", "Vendor Delivery", etc.
  trackingNumber  String?

  // Notes and documentation
  notes           String?
  receiptUrl      String?   // Uploaded receipt/invoice image

  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?

  // Relations
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])

  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([deliveryDate])
  @@index([createdAt])
}

model Reward {
  id          String  @id
  title       String
  description String
  cost        Int
  imageUrl    String?
  active      Boolean @default(true)
}

model SalesRep {
  id             String     @id
  name           String
  email          String     @unique
  phone          String?
  territory      String?
  uniqueLinkCode String     @unique
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  // User account link (for login/auth)
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id])
  // Customers assigned to this sales rep
  customers      Customer[]
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
}

model SpecialOffer {
  id          String    @id
  title       String
  description String?
  imageUrl    String?
  ctaText     String    @default("Shop Now")
  ctaLink     String?
  validUntil  DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Product     Product[] @relation("OfferProducts")
}

model Subcategory {
  id           String    @id
  name         String
  description  String?
  displayOrder Int       @default(0)
  categoryId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Product      Product[]
  Category     Category  @relation(fields: [categoryId], references: [id])
}

model User {
  id                     String                  @id
  email                  String                  @unique
  name                   String
  role                   String                  @default("CUSTOMER")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  password               String                  @default("")
  ApiKey                 ApiKey[]
  ContractWorker         ContractWorker?
  LoyaltyAccount         LoyaltyAccount?
  OAuthConnection        OAuthConnection[]
  Order                  Order[]
  Session                Session[]
  UserBadge              UserBadge[]
  SalesRep               SalesRep?
  activities             EmployeeActivity[]
  createdPriceOverrides  CustomerPriceOverride[] @relation("PriceOverrideCreator")
  approvedPriceOverrides CustomerPriceOverride[] @relation("PriceOverrideApprover")
}

model UserBadge {
  id       String   @id
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  Badge    Badge    @relation(fields: [badgeId], references: [id])
  User     User     @relation(fields: [userId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_REP
  WAREHOUSE
  DRIVER
  CUSTOMER
}

// ============================================
// CATALOG SECTION SYSTEM (Alessa-style layout)
// ============================================

model CatalogSection {
  id          String               @id @default(uuid())
  name        String
  description String?
  type        CatalogSectionType   @default(GROCERY)
  position    Int                  @default(0)
  hero        Boolean              @default(false)
  imageUrl    String?
  badgeText   String?
  badgeColor  String?              @default("#10b981")
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       CatalogSectionItem[]

  @@index([position])
  @@index([active])
}

model CatalogSectionItem {
  id           String         @id @default(uuid())
  sectionId    String
  productId    String
  displayOrder Int            @default(0)
  featured     Boolean        @default(false)
  section      CatalogSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@unique([sectionId, productId])
  @@index([sectionId])
  @@index([displayOrder])
}

enum CatalogSectionType {
  GROCERY
  CHIPS
  CANDY
  BEVERAGES
  SEASONAL
  SPECIAL
  BUNDLES
  FEATURED
  BAKERY
  DAIRY
  OTHER
}

// ============================================
// CATALOG BLOCK BUILDER SYSTEM
// ============================================

model CatalogSettings {
  id                 String   @id @default("default")
  backgroundGradient String   @default("linear-gradient(180deg, #0f3d0f 0%, #1a4d1a 50%, #0d2e0d 100%)")
  backgroundPattern  String?
  patternOpacity     Float    @default(0.1)
  patternSize        String?  @default("40px 40px")
  headerStyle        String   @default("default")
  primaryColor       String   @default("#d4a853")
  secondaryColor     String   @default("#059669")
  animation          String? // pulse, shimmer, gradient-shift, aurora
  glowEffect         Boolean  @default(false)
  particleEffect     String? // confetti, sparkle, etc
  updatedAt          DateTime @updatedAt
}

// ============================================
// FAVORITES UI SETTINGS (Rep Dashboard)
// ============================================
model FavoritesUISettings {
  id                 String   @id @default("default")
  // Background
  backgroundGradient String   @default("linear-gradient(180deg, #0f172a 0%, #1e293b 50%, #0f172a 100%)")
  backgroundPattern  String?
  patternOpacity     Float    @default(0.1)
  patternSize        String?  @default("40px 40px")
  // Card Styling
  cardBackground     String   @default("linear-gradient(135deg, #ffffff 0%, #f9fafb 100%)")
  cardBorderRadius   String   @default("16px")
  cardShadow         String   @default("0 4px 6px -1px rgba(0,0,0,0.1)")
  cardHoverScale     Float    @default(1.02)
