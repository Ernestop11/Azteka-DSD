}

model CatalogBlock {
  id        String                @id @default(uuid())
  type      CatalogBlockType      @default(PRODUCT_GRID)
  title     String?
  subtitle  String?
  badgeText String?
  ctaText   String?
  ctaLink   String?
  config    Json                  @default("{}")
  position  Int                   @default(0)
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  products  CatalogBlockProduct[]

  @@index([position])
  @@index([active])
}

model CatalogBlockProduct {
  id           String       @id @default(uuid())
  blockId      String
  productId    String
  displayOrder Int          @default(0)
  block        CatalogBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([blockId, productId])
  @@index([blockId])
  @@index([displayOrder])
}

enum CatalogBlockType {
  HERO
  PRODUCT_GRID
  PRODUCT_CARDS
  BANNER
  CATEGORY_ROW
  PROMO_SECTION
  // DSD Wholesale Block Types
  RACK_BUNDLE
  VENDOR_SPOTLIGHT
  CASE_DEAL
  NEW_ARRIVALS
  QUICK_REORDER
  BULK_BUILDER
  SEASONAL_THEME
  BRAND_SHOWCASE
  // Creative/Visual Block Types
  CHARACTER_STAGE
  // Weekend Special - Gamified promotional block
  WEEKEND_SPECIAL
}

// ============================================
// BUSINESS SETTINGS (Singleton)
// ============================================

model BusinessSettings {
  id                 String   @id @default("default")
  name               String   @default("Azteka DSD")
  address            String   @default("")
  city               String   @default("")
  state              String   @default("TX")
  zipCode            String   @default("")
  phone              String   @default("")
  email              String   @default("")
  website            String   @default("")
  taxId              String   @default("")
  warehouseAddress   String   @default("")
  warehouseCity      String   @default("")
  warehouseState     String   @default("TX")
  warehouseZipCode   String   @default("")
  deliveryRadius     Int      @default(50)
  businessHoursOpen  String   @default("06:00")
  businessHoursClose String   @default("18:00")
  businessDays       String   @default("Mon-Sat")
  cartBlocksConfig   Json? // JSON config for cart checkout blocks
  kioskSettings      Json? // JSON config for kiosk/time clock customization
  updatedAt          DateTime @updatedAt
}

// ============================================
// CART BLOCK SYSTEM (for cart drawer UI)
// ============================================

model CartBlock {
  id        String        @id @default(uuid())
  type      CartBlockType
  title     String?
  config    Json          @default("{}")
  position  Int           @default(0)
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  products  CartBlockProduct[]

  @@index([position])
  @@index([enabled])
}

model CartBlockProduct {
  id           String    @id @default(uuid())
  blockId      String
  productId    String
  displayOrder Int       @default(0)
  block        CartBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@unique([blockId, productId])
  @@index([blockId])
}

enum CartBlockType {
  CART_ITEMS       // Current cart contents (always shown)
  COMPLETE_ORDER   // Upsell suggestions based on cart
  TRENDING_NOW     // Popular products to add
  PREVIOUSLY_ORDERED // Customer's past purchases
  BUNDLE_PROGRESS  // Progress toward bundle deals
  REWARDS_STATUS   // Points balance and rewards
}

// ============================================
// REWARDS SYSTEM (Domino's style)
// ============================================

model RewardTier {
  id         String   @id @default(uuid())
  name       String   // "Bronze", "Silver", "Gold", "Platinum"
  minSpend   Decimal  @db.Decimal(10, 2) // Min monthly spend to qualify
  color      String   // Tier color for UI
  multiplier Float    @default(1.0) // Points multiplier
  position   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([position])
}

model RewardPrize {
  id          String   @id @default(uuid())
  name        String   // "Free Case of Takis"
  description String?
  imageUrl    String?
  pointsCost  Int      // Points to redeem
  stock       Int      @default(0) // Available quantity
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TradeOffDeal {
  id                String   @id @default(uuid())
  name              String   // "Electrolit at Cost"
  description       String?
  rewardProductId   String?  // Product they get at special price
  rewardBrandId     String?  // Or brand they get at special price
  rewardPrice       Decimal  @db.Decimal(10, 2) // Special price
  rewardMaxQty      Int      // Max units at this price
  requirementType   String   // "MIN_ORDER", "MIN_AVERAGE", "EXCLUDE_BRAND"
  minSpend          Decimal  @db.Decimal(10, 2) // Min $ to qualify
  excludeBrandId    String?  // Brand to exclude from calculation
  excludeCategoryId String?  // Category to exclude
  active            Boolean  @default(true)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active])
}

// ============================================
// CATEGORY & BRAND LAYOUT BLOCKS
// ============================================

model CategoryLayout {
  id          String   @id @default(uuid())
  categoryId  String   @unique
  config      Json     @default("{}") // Layout configuration
  heroImage   String?
  heroTitle   String?
  heroSubtitle String?
  showSubcategories Boolean @default(true)
  showBundles Boolean @default(true)
  gridColumns Int     @default(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model BrandLayout {
  id          String   @id @default(uuid())
  brandId     String   @unique
  config      Json     @default("{}") // Layout configuration
  heroImage   String?
  heroGradient String?
  showLogo    Boolean  @default(true)
  featured    Boolean  @default(false)
  gridColumns Int      @default(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

// ============================================
// EMPLOYEE TIME CLOCK SYSTEM
// ============================================

model Employee {
  id             String          @id @default(uuid())
  firstName      String
  lastName       String
  phone          String          @unique // Full phone number
  pin            String // Last 4 digits of phone (for kiosk login)
  email          String?         @unique
  role           EmployeeRole    @default(WAREHOUSE)
  // Pay configuration
  payType        PayType         @default(HOURLY) // HOURLY, SALARY, COMMISSION
  hourlyRate     Decimal         @default(0) @db.Decimal(10, 2)
  salary         Decimal?        @db.Decimal(10, 2) // Weekly salary for SALARY type
  commissionRate Decimal?        @db.Decimal(5, 2) // Commission % for sales (e.g., 5.00 = 5%)
  bonusEligible  Boolean         @default(false) // Can receive performance bonuses
  active         Boolean         @default(true)
  photoUrl       String? // Profile photo
  hireDate       DateTime        @default(now())
  needsPinReset  Boolean         @default(false) // True if PIN is 0000, needs reset on first login
  // Password hash for admin portal login (only for SUPER_ADMIN, ADMIN, SALES_REP, MANAGER)
  passwordHash   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  timeEntries    TimeEntry[]
  tasks          Task[] // Assigned tasks
  receivedPOs    PurchaseOrder[] // POs this employee received
  workOrders     WorkOrder[] // Work orders assigned to this employee
  activityLogs   ActivityLog[]   @relation("EmployeeActivityLogs")
  // Payroll adjustments (bonuses, deductions, commissions)
  payrollAdjustments PayrollAdjustment[]
  // Inventory count relations
  countedItems   InventoryCountItem[] @relation("ItemCounter")
  checkedItems   InventoryCountItem[] @relation("ItemChecker")

  @@index([pin])
  @@index([active])
  @@index([role])
  @@index([email])
}

enum PayType {
  HOURLY     // Paid by the hour
  SALARY     // Fixed weekly salary
  COMMISSION // Commission-based (usually + base)
}

// Track bonuses, commissions, deductions per pay period
model PayrollAdjustment {
  id          String               @id @default(uuid())
  employeeId  String
  employee    Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        PayrollAdjustmentType
  amount      Decimal              @db.Decimal(10, 2)
  description String?
  // For commissions: link to specific orders
  orderId     String?
  // Pay period this applies to
  periodStart DateTime
  periodEnd   DateTime
  // Who approved this
  approvedBy  String?
  approvedAt  DateTime?
  status      AdjustmentStatus     @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([employeeId])
  @@index([periodStart, periodEnd])
  @@index([status])
}

enum PayrollAdjustmentType {
  BONUS           // Performance bonus
  COMMISSION      // Sales commission
  OVERTIME_BONUS  // Extra OT pay
  DEDUCTION       // Deduction (advances, etc.)
  REIMBURSEMENT   // Expense reimbursement
  ADJUSTMENT      // Manual adjustment
}

enum AdjustmentStatus {
  PENDING   // Awaiting approval
  APPROVED  // Approved for payroll
  PAID      // Included in payroll run
  REJECTED  // Rejected
}

model TimeEntry {
  id            String          @id @default(uuid())
  employeeId    String
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn       DateTime
  clockOut      DateTime?
  clockInPhoto  String? // Photo URL taken at clock-in
  clockOutPhoto String? // Photo URL taken at clock-out
  hoursWorked   Decimal?        @db.Decimal(5, 2) // Calculated on clock-out
  notes         String?
  status        TimeEntryStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([employeeId])
  @@index([clockIn])
  @@index([status])
}

enum EmployeeRole {
  SUPER_ADMIN  // Full access - Ernesto, Ana, Xeki
  ADMIN        // Admin access - Ana (PO, accounting, deposits)
  SALES_REP    // Mobile sales - Xeki (truck restocking, deliveries)
  MANAGER      // Department manager
  WAREHOUSE    // Warehouse staff (picking, packing)
  DRIVER       // Delivery driver
  OFFICE       // Office staff
}

enum TimeEntryStatus {
  ACTIVE // Currently clocked in
  COMPLETED // Clocked out normally
  ADJUSTED // Manually adjusted by admin
}

// Employee Activity Log - tracks all work activities for worksheets
model EmployeeActivity {
  id String @id @default(cuid())

  // Who did the action
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What type of action
  actionType ActivityType

  // Reference to related entity (productId, orderId, etc.)
  entityType String? // "product", "order", "delivery", etc.
  entityId   String? // The ID of the related entity
  entityName String? // Human-readable name (product name, order #, etc.)

  // Details of what was done
  description String // Human-readable description
  metadata    Json? // Additional structured data (old/new values, quantities, etc.)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum ActivityType {
  // Inventory actions
  STOCK_UPDATE // Changed stock quantity
  LOCATION_UPDATE // Changed warehouse location
  SKU_UPDATE // Updated product SKU
  EXPIRATION_UPDATE // Set/changed expiration date
  IMAGE_UPLOAD // Uploaded product image
  PRODUCT_CLASSIFY // Changed category/brand

  // Order actions
  ORDER_PICKED // Picked an order item
  ORDER_PACKED // Packed an order
  ORDER_STATUS_CHANGE // Changed order status

  // Delivery actions
  DELIVERY_START // Started a delivery route
  DELIVERY_COMPLETE // Completed a delivery
  DELIVERY_ISSUE // Reported delivery issue

  // Receiving actions
  SHIPMENT_RECEIVE // Received incoming shipment
  STOCK_COUNT // Performed inventory count

  // Time clock
  CLOCK_IN // Clocked in
  CLOCK_OUT // Clocked out

  // Picking & Packing
  PICK_STARTED // Started picking an order
  PICK_ITEM // Picked an individual item
  PICK_COMPLETED // Completed picking entire order
  BOX_CREATED // Created a new box for packing
  BOX_SEALED // Sealed a box for delivery
}

// ============================================
// TASK MANAGEMENT SYSTEM (for auto-workflow)
// ============================================

model Task {
  id          String   @id @default(uuid())
  type        TaskType @default(PICKING)
  title       String
  description String?

  // Assignment
  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])

  // Related order (if applicable)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Related purchase order (for receiving tasks)
  purchaseOrderId String?        @unique
  purchaseOrder   PurchaseOrder? @relation("POReceivingTask", fields: [purchaseOrderId], references: [id])

  // Status tracking
  status   TaskStatus   @default(PENDING)
  priority TaskPriority @default(NORMAL)

  // Timestamps
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // Completion notes
  notes String?

  // Auto-print tracking
  autoPrinted Boolean @default(false)
  printJobId  String? // Reference to PrintJob if printed

  @@index([assigneeId])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

enum TaskType {
  PICKING // Pick items for an order
  PACKING // Pack items into boxes
  RECEIVING // Receive incoming inventory
  STOCKING // Stock items on shelves
  DELIVERY // Deliver to customer
  COUNTING // Inventory count
  MAPPING // Warehouse location mapping
}

enum TaskStatus {
  PENDING // Not started
  ASSIGNED // Assigned to employee
  IN_PROGRESS // Being worked on
  COMPLETED // Done
  CANCELLED // Cancelled
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================
// ACTIVITY LOG (simple audit trail)
// ============================================

model ActivityLog {
  id          String @id @default(uuid())
  type        String // e.g., "RECEIVING_CLAIMED", "ITEM_RECEIVED", "RECEIVING_COMPLETED"
  description String
  metadata    Json?

  // Who performed the action
  employeeId String?
  employee   Employee? @relation("EmployeeActivityLogs", fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// BOX & QR CODE SYSTEM (for delivery tracking)
// ============================================

model Box {
  id String @id @default(uuid())

  // Order relationship
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // QR code for scanning
  qrCode String @unique // Unique identifier for QR

  // Contents
  items BoxItem[]

  // Status
  status BoxStatus @default(PACKING)

  // Timestamps
  createdAt   DateTime  @default(now())
  sealedAt    DateTime?
  deliveredAt DateTime?

  // Who packed it
  packedById String?

  @@index([orderId])
  @@index([qrCode])
  @@index([status])
}

model BoxItem {
  id String @id @default(uuid())

  boxId String
  box   Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  // Track if picked/confirmed
  picked Boolean @default(false)

  @@index([boxId])
  @@index([productId])
}

enum BoxStatus {
  PACKING // Being packed
  SEALED // Sealed and ready
  IN_TRANSIT // On delivery truck
  DELIVERED // Delivered to customer
}

// ============================================
// DELIVERY CONFIRMATION SYSTEM
// ============================================

model DeliveryConfirmation {
  id String @id @default(uuid())

  // Order relationship
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  // Secure token for customer access (no login required)
  token String @unique @default(uuid())

  // Signatures (base64 encoded images)
  driverSignature   String? @db.Text
  customerSignature String? @db.Text

  // Item confirmation (JSON array)
  confirmedItems Json? // [{productId, confirmed: bool, issue?: string, photoUrl?: string}]

  // Driver info (who initiated the delivery)
  driverName String?
  driverId   String?

  // Customer info
  customerName  String?
  customerPhone String?

  // Notes and issues
  notes     String? @db.Text
  hasIssues Boolean @default(false)

  // Timestamps
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([token])
  @@index([orderId])
}

// ============================================
// PRINT JOB QUEUE (for auto-printing)
// ============================================

model PrintJob {
  id String @id @default(uuid())

  // Type of document
  type PrintJobType

  // Printer info
  printerId String? // Printer ID/name

  // Content
  payload Json // Document data to print

  // Status
  status PrintJobStatus @default(QUEUED)
  copies Int            @default(1)

  // Reference to what triggered the print
  sourceType String? // "order", "task", "box"
  sourceId   String?

  // Timestamps
  createdAt DateTime  @default(now())
  printedAt DateTime?

  // Error info if failed
  errorMsg String?
  retries  Int     @default(0)

  @@index([status])
  @@index([createdAt])
}

enum PrintJobType {
  PICKING_LIST // List of items to pick
  PACKING_SLIP // Slip to include in box
  BOX_LABEL // QR code label for box
  INVOICE // Customer invoice
  DELIVERY_SHEET // Driver delivery manifest
}

enum PrintJobStatus {
  QUEUED // Waiting to print
  PRINTING // Currently printing
  COMPLETED // Successfully printed
  FAILED // Print failed
  CANCELLED // Cancelled
}

// Print Agent registration (local print agents that poll for jobs)
model PrintAgent {
  id            String   @id @default(uuid())
  name          String   @unique // e.g., "warehouse-mac"
  secret        String   // API key for authentication
  lastHeartbeat DateTime?
  printerStatus String   @default("UNKNOWN") // ONLINE, OFFLINE, ERROR, UNKNOWN
  printerName   String?  // e.g., "HP_Color_LaserJet_MFP_M281fdw"
  queueDepth    Int      @default(0)
  lastError     String?
  ipAddress     String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([lastHeartbeat])
}

// ============================================
// CUSTOMER GROUPS (for multi-account reporting)
// ============================================

model CustomerGroup {
  id    String  @id @default(uuid())
  name  String
  email String // Primary contact email for reports
  phone String?
  notes String?

  // Customers in this group
  customers Customer[] @relation("CustomerGroupMembers")

  // Report settings
  sendWeeklyReport Boolean @default(true)
  reportDay        Int     @default(1) // 0=Sunday, 1=Monday, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================
// WORK ORDER SYSTEM (for catalog/admin tasks)
// ============================================

model WorkOrder {
  id          String          @id @default(uuid())
  type        WorkOrderType
  title       String
  description String?
  status      WorkOrderStatus @default(PENDING)
  priority    TaskPriority    @default(NORMAL)

  // Assignment (optional - for Ernesto or other admin)
  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])

  // Related product (for NEW_PRODUCT_CATALOG, PRICE_UPDATE, IMAGE_NEEDED)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // Related PO (for receiving-triggered work orders)
  purchaseOrderId String?

  // Extra data (vendor info, suggested price, etc)
  metadata Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([type])
  @@index([assigneeId])
  @@index([productId])
  @@index([createdAt])
}

enum WorkOrderType {
  NEW_PRODUCT_CATALOG // New product needs to be added to catalog
  PRICE_UPDATE // Price needs review/update
  IMAGE_NEEDED // Product needs image
  INVENTORY_COUNT // Inventory count required
  VENDOR_SETUP // New vendor needs setup
}

enum WorkOrderStatus {
  PENDING // Not started
  IN_PROGRESS // Being worked on
  COMPLETED // Done
  CANCELLED // Cancelled
}

// ============================================
// CUSTOMER PRICE OVERRIDE SYSTEM
// ============================================

model CustomerPriceOverride {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Pricing Options
  overrideType    OverrideType @default(FIXED_PRICE)
  fixedPrice      Decimal?     @db.Decimal(10, 2) // Fixed price override
  discountPercent Decimal?     @db.Decimal(5, 2) // Percentage discount (e.g., 10 = 10% off)
  discountAmount  Decimal?     @db.Decimal(10, 2) // Fixed discount amount

  // Tiered Pricing (for volume discounts)
  minQuantity Int? // Minimum quantity for this price
  maxQuantity Int? // Maximum quantity (null = unlimited)

  // Contract/Agreement
  contractNumber String?
  notes          String?
  startDate      DateTime?
  endDate        DateTime? // Expiration date (null = no expiration)

  // Status
  active Boolean @default(true)

  // Audit Trail
  createdById  String
  createdBy    User     @relation("PriceOverrideCreator", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?    @relation("PriceOverrideApprover", fields: [approvedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([customerId, productId, minQuantity]) // Allow multiple tiers per product
  @@index([customerId])
  @@index([productId])
  @@index([active])
  @@index([endDate])
}

enum OverrideType {
  FIXED_PRICE // Set exact price: $22.99
  PERCENTAGE_DISCOUNT // 10% off standard price
  FIXED_DISCOUNT // $2.00 off standard price
  TIERED // Volume-based pricing
}

// ===== CUSTOMER CRM MODELS =====

// Product Request - formal workflow for customer product requests
model ProductRequest {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Product details (may be for new or existing product)
  productName     String
  productSku      String?             // Optional - if known
  description     String?             @db.Text
  competitorPrice Decimal?            @db.Decimal(10, 2)
  competitorName  String?             // Where customer saw the product
  imageUrl        String?             // Photo of product/competitor price

  // Workflow status: PENDING, IN_REVIEW, APPROVED, REJECTED, FULFILLED
  status          String              @default("PENDING")
  priority        String              @default("NORMAL")

  // Resolution
  resolvedProductId String?           // Link to product if approved/found
  adminNotes      String?             @db.Text

  // Audit
  createdById     String              // Rep who submitted
  reviewedById    String?             // Admin who reviewed
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reviewedAt      DateTime?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// Customer Survey - structured feedback collection
model CustomerSurvey {
  id                     String   @id @default(uuid())
  customerId             String
  customer               Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Survey date and conductor
  surveyDate             DateTime @default(now())
  conductedById          String   // Rep who conducted survey

  // Structured ratings (1-5 scale)
  satisfactionScore      Int      // Overall satisfaction 1-5
  serviceQuality         Int      // Service quality 1-5
  deliveryRating         Int?     // Delivery timeliness 1-5
  productQuality         Int?     // Product quality 1-5
  pricingFairness        Int?     // Pricing satisfaction 1-5

  // Freeform feedback
  notes                  String?  @db.Text
  productFeedback        String?  @db.Text  // Specific product comments
  improvementSuggestions String?  @db.Text

  // Follow-up
  followUpRequired       Boolean  @default(false)
  followUpNotes          String?  @db.Text
  followUpCompleted      Boolean  @default(false)

  createdAt              DateTime @default(now())

  @@index([customerId])
  @@index([surveyDate])
  @@index([conductedById])
}

// Customer Document - uploaded invoices, competitor pricing, etc.
model CustomerDocument {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Document type: COMPETITOR_INVOICE, COMPETITOR_CATALOG, CONTRACT, TAX_EXEMPT, OTHER
  type          String
  fileUrl       String
  fileName      String
  fileSize      Int?
  mimeType      String?

  // OCR extraction (for competitor invoices)
  extractedText String?  @db.Text
  extractedData Json?    // Structured OCR results { products: [{name, price, sku}] }
  ocrConfidence Float?

  // Metadata
  notes         String?  @db.Text
  uploadedById  String   // Rep who uploaded

  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// INVENTORY COUNT SYSTEM (Annual Physical Count)
// ============================================

model InventoryCount {
  id               String               @id @default(uuid())
  name             String               // "2026 Annual Count"
  status           InventoryCountStatus @default(OPEN)
  notes            String?              @db.Text
  snapshotTakenAt  DateTime?            // When expected quantities were captured
  totalCases       Int                  @default(0)
  totalCapitalCost Decimal              @default(0) @db.Decimal(12, 2)
  totalCapitalSell Decimal              @default(0) @db.Decimal(12, 2)
  createdAt        DateTime             @default(now())
  closedAt         DateTime?
  items            InventoryCountItem[]

  @@index([status])
  @@index([createdAt])
}

enum InventoryCountStatus {
  OPEN     // Actively counting
  CLOSED   // Finished, locked
  ARCHIVED // Historical record
}

model InventoryCountItem {
  id                String          @id @default(uuid())
  inventoryCountId  String
  inventoryCount    InventoryCount  @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId         String
  // Counter: Employee who counted this item
  counterId         String
  counter           Employee        @relation("ItemCounter", fields: [counterId], references: [id])
  // Checker: Employee who verified (optional)
  checkerId         String?
  checker           Employee?       @relation("ItemChecker", fields: [checkerId], references: [id])
  // Count data
  countedCases      Int             @default(0)
  countedPieces     Int             @default(0)
  countedTotal      Int             @default(0) // Total units (cases * unitsPerCase + pieces)
  expectedQuantity  Int             @default(0) // From system stock
  variance          Int             @default(0) // countedTotal - expectedQuantity
  unitsPerCase      Int             @default(1)
  // Product info captured at count time
  warehouseLocation String?         // e.g., "A-12-3"
  needsDateCheck    Boolean         @default(false) // RED FLAG - expiration needs checking
  expirationDate    DateTime?
  lotNumber         String?
  sku               String?
  caseSku           String?
  // Verification status
  status            CountItemStatus @default(COUNTED)
  // Correction tracking
  correctionNote    String?         @db.Text
  originalCount     Int?            // Preserved when corrected
  // Timestamps
  countedAt         DateTime        @default(now())
  verifiedAt        DateTime?

  @@unique([inventoryCountId, productId])
  @@index([inventoryCountId])
  @@index([counterId])
  @@index([checkerId])
  @@index([status])
  @@index([needsDateCheck])
  @@index([warehouseLocation])
}

enum CountItemStatus {
  COUNTED        // Initial count done
  VERIFIED       // Checker approved
  RECOUNT_NEEDED // Checker flagged for recount
  CORRECTED      // Checker made correction
}

// Key-value settings storage for app configuration
model Setting {
  key         String   @id
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// STORE MANAGER SYSTEM (Multi-store delegation)
// ============================================

// Store Manager - for multi-store owners to delegate ordering
model StoreManager {
  id          String   @id @default(uuid())
  // Owner who created this manager
  ownerId     String
  // Manager details
  name        String
  phone       String
  email       String?
  // Status
  active      Boolean  @default(true)
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Assignments to stores
  assignments StoreManagerAssignment[]

  @@index([ownerId])
  @@index([phone])
  @@index([active])
}

// Store Manager Assignment - links managers to specific stores
model StoreManagerAssignment {
  id         String       @id @default(uuid())
  managerId  String
  manager    StoreManager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  storeId    String       // Customer ID of the store
  // Assignment details
  role       String       @default("MANAGER") // MANAGER, ASSISTANT, etc.
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  @@unique([managerId, storeId])
  @@index([managerId])
  @@index([storeId])
}
