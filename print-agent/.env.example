# Azteka Print Agent Configuration
# Copy this file to .env and fill in your values

# VPS URL (your live site)
VPS_URL=https://azteka.yourdomain.com

# Secret key (must match PRINT_AGENT_SECRET on VPS)
PRINT_AGENT_SECRET=your-secret-key-here

# Agent name (defaults to hostname)
# AGENT_NAME=warehouse-mac

# CUPS printer name (run 'lpstat -p' to list available printers)
PRINTER_NAME=HP_Color_LaserJet_MFP_M281fdw__FD3E28_

# Poll interval in seconds (default: 5)
# POLL_INTERVAL=5
